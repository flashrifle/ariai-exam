# ─────────────────────────────────────────────────────────────
# 이 파일을 backend/.env 로 복사해 사용하세요.
#   cp .env.example backend/.env
# Binance 공개 마켓 데이터만 사용하므로 API 키는 필요하지 않습니다.
# ─────────────────────────────────────────────────────────────

# 실행 환경
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# 데이터베이스 (infra/docker-compose.yml 의 기본값과 일치)
DATABASE_URL=postgresql://ariai:ariai_local_pw@localhost:5434/ariai
DB_POOL_MAX=10

# Binance 엔드포인트
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# 수집 대상 심볼 (쉼표 구분)
SYMBOLS=BTCUSDT,ETHUSDT

# 백필 / 갭 복구
#  - 최초 실행 시 과거 며칠치를 채울지
BOOTSTRAP_BACKFILL_DAYS=3
#  - 누락 구간 스캔 주기(초)
GAP_SCAN_INTERVAL_SEC=60
#  - 갭 스캔이 훑는 과거 구간(시간)
GAP_SCAN_LOOKBACK_HOURS=24
#  - 분당 사용할 REST weight 예산 (Binance IP 한도 6000 중 일부만 사용)
REST_WEIGHT_BUDGET_PER_MIN=2400

# 체결 데이터 배치 기록
TRADE_FLUSH_INTERVAL_MS=1000
TRADE_FLUSH_MAX_ROWS=500

# 지표 계산
METRICS_REFRESH_MS=2000
METRICS_WINDOW_MINUTES=60

# 보존 정책 (원본 체결 데이터)
TRADE_RETENTION_DAYS=7

# ─── 프론트엔드 (frontend/.env.local 로 복사) ───────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
