# 이 파일을 frontend/.env.local 로 복사해 사용하세요.
#   cp .env.local.example .env.local

# 백엔드 API 베이스 (docs/CONTRACT.md 5절)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# 백엔드 없이 화면만 확인할 때만 true.
# 기본값은 false 이며, 실제 API 를 호출한다.
# true 일 때만 src/lib/mock/** 이 동적 import 되어 목 응답과 가짜 SSE 를 사용한다.
NEXT_PUBLIC_USE_MOCK=false
